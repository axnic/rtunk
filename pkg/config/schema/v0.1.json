{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtunk://schema/v0.1",
  "title": "rtunk configuration",
  "description": "Schema for .rtunk/rtunk.yaml and .trunk/trunk.yaml version 0.1",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {
      "description": "Schema version — only 0.1 is accepted",
      "type": "number",
      "const": 0.1
    },
    "cli": {
      "type": "object",
      "properties": {
        "version": { "type": ["string", "number", "boolean"] },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commands": { "type": "array", "items": { "type": "string" } },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "dir": { "type": "string" }
      }
    },
    "repo": {
      "type": "object",
      "properties": {
        "trunk_branch": { "type": "string" },
        "remote_hint": { "type": "string" },
        "use_branch_upstream": { "type": "boolean" }
      }
    },
    "runtimes": {
      "type": "object",
      "properties": {
        "enabled": { "type": "array", "items": { "type": "string" } }
      }
    },
    "plugins": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "uri": { "type": "string" },
              "ref": { "type": "string" }
            }
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "definitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/linter_definition" }
        },
        "enabled": { "type": "array", "items": { "type": "string" } },
        "disabled": { "type": "array", "items": { "type": "string" } },
        "ignore": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "linters": { "type": "array", "items": { "type": "string" } },
              "paths": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "linters": { "type": "array", "items": { "type": "string" } },
              "paths": { "type": "array", "items": { "type": "string" } },
              "targets": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "enabled": { "type": "array", "items": { "type": "string" } },
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "download": { "type": "string" },
              "known_good_version": { "type": "string" },
              "shims": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "properties": {
        "enabled": { "type": "array", "items": { "type": "string" } },
        "disabled": { "type": "array", "items": { "type": "string" } }
      }
    },
    "telemetry": { "type": "boolean" }
  },
  "$defs": {
    "linter_definition": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "runtime": { "type": "string" },
        "download": { "$ref": "#/$defs/download" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "download": {
      "type": "object",
      "properties": {
        "github": { "type": "string" },
        "version": { "type": "string" },
        "asset": { "type": "string" },
        "checksums": { "type": "string" },
        "arch_map": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "bin": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "run": { "type": "string" },
        "target": { "type": "string" },
        "run_from": { "type": "string" },
        "stdin": { "type": "boolean" },
        "output": { "type": "string" },
        "parser": {
          "type": "object",
          "properties": {
            "runtime": { "type": "string" },
            "run": { "type": "string" }
          }
        },
        "parse_regex": { "type": "string" },
        "read_output_from": { "type": "string" },
        "success_codes": { "type": "array", "items": { "type": "integer" } },
        "error_codes": { "type": "array", "items": { "type": "integer" } },
        "no_issues_codes": { "type": "array", "items": { "type": "integer" } },
        "batch": { "type": "boolean" },
        "formatter": { "type": "boolean" },
        "in_place": { "type": "boolean" },
        "cache_results": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "max_concurrency": { "type": "integer" },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "string" },
        "severity": { "type": "string" },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "list": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
